args = "npm run dev:client"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/mockup-sandbox && PORT=5173 BASE_PATH=/__mockup/ npm run dev"
waitForPort = 5173

[workflows.workflow.metadata]
outputType = "console"
isCanvasWorkflow = true

