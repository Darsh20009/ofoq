args = "artifacts/mockup-sandbox: Component Preview Server"

[[workflows.workflow]]
name = "OFOQ Backend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"

[[workflows.workflow]]
name = "OFOQ Frontend"
author = "agent"

[[workflows.workflow.tasks]]
