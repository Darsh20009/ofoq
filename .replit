modules = ["nodejs-20", "web", "nix"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[userenv.shared]
APP_NAME = "OFOQ Business Solutions"
APP_NAME_AR = "أفق لحلول الأعمال"
APP_URL = "https://ofoqhc.com"
LANG_DEFAULT = "ar"
NODE_ENV = "development"
PORT = "5000"
UPLOAD_MAX_SIZE = "10485760"
JWT_EXPIRES_IN = "7d"
APPLE_CLIENT_ID = "com.ofoqhc"
APPLE_KEY_ID = "536AY95XA7"
APPLE_TEAM_ID = "V4K6RM59LS"
APPLE_WALLET_PASS_ID = "pass.com.qirox.employee"
APPLE_WALLET_TEAM_ID = "V4K6RM59LS"
CPANEL_SMTP_HOST = "server222.web-hosting.com"
CPANEL_SMTP_PORT = "465"
CPANEL_SMTP_USER = "info@qirox.online"
CPANEL_USERNAME = "rfpeddku"
EMAIL_SENDER_NAME = "أفق لحلول الأعمال"
EMPLOYEE_URL = "https://employee.ofoqhc.com"
GOOGLE_CLIENT_ID = "722115647290-f6dl35qs3611p4ohi24ljuku26ndnf9l.apps.googleusercontent.com"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "OFOQ Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "OFOQ Frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/mockup-sandbox: Component Preview Server"

[[workflows.workflow]]
name = "OFOQ Backend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"

[[workflows.workflow]]
name = "OFOQ Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev:client"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/mockup-sandbox && PORT=5173 BASE_PATH=/__mockup/ npm run dev"
waitForPort = 5173

[workflows.workflow.metadata]
outputType = "console"
isCanvasWorkflow = true

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3003

[[ports]]
